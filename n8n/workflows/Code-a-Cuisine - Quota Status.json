      "parameters": {
        "jsCode": "const headers = $json.headers ?? {};\nfunction header(name) {\n  const value = headers[name] ?? headers[name.toLowerCase()] ?? headers[name.toUpperCase()];\n  return typeof value === 'string' ? value.trim() : '';\n}\nfunction isIpv4(value) {\n  const parts = value.split('.');\n  return parts.length === 4 && parts.every((part) => {\n    if (!/^\\d{1,3}$/.test(part)) return false;\n    const number = Number(part);\n    return number >= 0 && number <= 255 && String(number) === String(Number(part));\n  });\n}\nfunction isIpv6(value) {\n  let ip = value.toLowerCase();\n  if (ip.startsWith('::ffff:') && ip.includes('.')) return isIpv4(ip.slice(7));\n  if (!/^[0-9a-f:]+$/.test(ip) || ip.includes(':::')) return false;\n  const doubles = (ip.match(/::/g) ?? []).length;\n  if (doubles > 1) return false;\n  const parts = ip.split(':');\n  const groups = parts.filter(Boolean);\n  if (!groups.every((part) => part.length <= 4 && /^[0-9a-f]+$/.test(part))) return false;\n  return ip.includes('::') ? groups.length < 8 : groups.length === 8;\n}\nconst candidate =\n  header('cf-connecting-ip') ||\n  header('x-real-ip') ||\n  header('x-forwarded-for').split(',')[0]?.trim() ||\n  '';\nconst clientIp = candidate.replace(/^\\[|\\]$/g, '');\nconst valid = isIpv4(clientIp) || isIpv6(clientIp);\nreturn [{ json: { valid, clientIp: valid ? clientIp : null } }];"
      },
